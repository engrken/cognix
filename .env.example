# Server-to-server bearer token. Generate a long random value.
COGNIX_API_KEY=

# App-specific server API configuration; never expose these to browsers.
SAGA_API_BASE_URL=
SAGA_SERVICE_TOKEN=
CLEAR_API_BASE_URL=
CLEAR_SERVICE_TOKEN=
ROAMPH_API_BASE_URL=
ROAMPH_SERVICE_TOKEN=

# Optional AI Gateway key for local development. Vercel deployments can use VERCEL_OIDC_TOKEN.
# Set AI_GATEWAY_MODEL only after reviewing its live pricing and configuring a spend limit.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# System Admin dashboard. Keep both values secret and use independent random values.
# COGNIX_ADMIN_SESSION_SECRET must be at least 32 characters.
COGNIX_ADMIN_PASSWORD=
COGNIX_ADMIN_SESSION_SECRET=

# Vercel Cron authentication for the daily read-only monitor.
CRON_SECRET=
