SAGA_SERVICE_TOKEN=
CLEAR_API_BASE_URL=
CLEAR_SERVICE_TOKEN=
ROAMPH_API_BASE_URL=
ROAMPH_SERVICE_TOKEN=

# Optional AI Gateway key for local development. Vercel deployments can use VERCEL_OIDC_TOKEN.
# Set AI_GATEWAY_MODEL only after reviewing its live pricing and configuring a spend limit.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
